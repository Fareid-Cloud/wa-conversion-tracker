# ═══════════════════════════════════════════════════════════════
#  wa-conversion-tracker — متغيّرات البيئة
#
#  انسخ هذا الملفّ إلى `.env.local` للتشغيل المحلّي، وأضف القيم نفسها
#  في إعدادات المشروع على Vercel للنشر.
#
#  ملاحظة: لم تعد هنا أيّ متغيّرات باسم عميل بعينه. بيانات كلّ مشترك
#  (رقم واتساب، حساب جوجل) تُقرأ من قاعدة البيانات، ويضبطها هو بنفسه
#  من إعدادات AdLoop. هذا ما جعل المتتبّع قابلاً للاستخدام كمنتج.
# ═══════════════════════════════════════════════════════════════

# === قاعدة البيانات (إجباري) ===
# **نفس قيمة DATABASE_URL في مشروع adloop-saas بالحرف.**
# المشروعان يتشاركان قاعدة Postgres نفسها: المتتبّع يكتب الكليكات في
# جدول `wa_clicks`، ويقرأ إعدادات مساحات العمل ليعرف صاحب كلّ رسالة.
# بدونه لا يعمل شيء - الجدول يُنشأ تلقائياً عند أوّل طلب.
DATABASE_URL=

# === WhatsApp ===
# نصّ عشوائي من عندك، تكتبه هنا وفي Meta وقت ربط الويب هوك ليتطابقا
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here
# App Secret من Meta for Developers - للتحقّق من توقيع كلّ ويب هوك وارد.
# بدونه يُرفض كلّ طلب: أي أحد يعرف عنوانك كان سيستطيع تلفيق تحويلات.
WHATSAPP_APP_SECRET=

# === Google Ads API (اختياري) ===
# مطلوبة فقط لرفع التحويلات المتحقّقة إلى جوجل كـOffline Conversions.
# اتركها فارغة إن لم تكن تُعلن على جوجل - التتبّع نفسه يعمل بدونها.
# معرّف حساب كلّ مشترك يأتي من إعداداته في AdLoop لا من هنا.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# === الاتصال بـ adloop-saas ===
# عنوان adloop-saas بلا / في الآخر - مثال: https://app.adloop.com
ADLOOP_API_BASE=
# سرّ مشترك بين المشروعين - **نفس القيمة بالضبط** في متغيّرات adloop-saas.
# به يثبت المتتبّع أنّ النداء منه هو لا من طرف خارجي.
INTERNAL_SERVICE_SECRET=
